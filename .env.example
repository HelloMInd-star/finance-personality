# ==================== 环境变量示例 ====================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ---------- 安全配置 ----------
# PostgreSQL 密码
POSTGRES_PASSWORD=your_secure_password_here

# JWT 密钥（生产环境请修改为随机字符串）
SECRET_KEY=your-secret-key-change-in-production-to-a-random-string

# Redis 密码（如需启用，还需在 docker-compose.yml 的 redis 服务中取消 --requirepass 注释）
# REDIS_PASSWORD=your_redis_password

# ---------- CORS 配置 ----------
# 允许的前端来源（逗号分隔，需配合后端 app.py 读取此环境变量）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 端口配置（按需修改，避免冲突） ----------
# 前端开发服务器端口（默认 5173）
FRONTEND_PORT=5173
# 后端 API 端口（默认 5000）
BACKEND_PORT=5000
# PostgreSQL 端口（默认 5432）
POSTGRES_PORT=5432
# Redis 端口（默认 6379）
REDIS_PORT=6379
# pgAdmin 端口（默认 5050，需 --profile devtools）
PGADMIN_PORT=5050

# ---------- 生产环境端口 ----------
# Nginx HTTP 端口（默认 80）
HTTP_PORT=80
# Nginx HTTPS 端口（默认 443）
HTTPS_PORT=443
